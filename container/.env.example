# Run ./scripts/init-env.ps1 to generate .env with local random secrets.
# Credentials must use URL-safe characters (the generator uses hexadecimal).
AIRFLOW_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_PORT=8080
# Optional separate source password; blank uses ANALYTICS_DB_PASSWORD.
SOURCE_DB_PASSWORD=
SOURCE_DETAIL_LATENCY_MS=100
SOURCE_API_PORT=8000
SOURCE_API_KEY=
